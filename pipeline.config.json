{
  "profile": "frontend-solid-vite",
  "language": "fr",
  "default_mode": "pipeline",
  "commands": {
    "check": "pnpm run check",
    "lint": "pnpm run lint",
    "format": "pnpm run format:check",
    "build": "pnpm run build",
    "test_unit": "pnpm run test:unit",
    "test_e2e": "pnpm run test:e2e",
    "coverage": "pnpm run test:coverage",
    "smoke": "pnpm run test:smoke",
    "accessibility": "pnpm run test:a11y",
    "architecture": "pnpm run check:architecture",
    "design_tokens": "pnpm run check:tokens",
    "css_ownership": "pnpm run check:css-ownership",
    "dead_code": "pnpm run check:dead-code",
    "duplication": "pnpm run check:duplication",
    "design_limits": "pnpm run check:design-limits",
    "comment_policy": "pnpm run check:comments",
    "doc_lint": "pnpm run check:docs",
    "sast": "pnpm run check:security",
    "secrets_scan": "pnpm run scan:secrets",
    "audit": "pnpm audit --audit-level high",
    "tracker_sync": "node agent-pipeline/scripts/tracker-sync.mjs",
    "project_map": "pnpm run project-map -- --check",
    "map_coverage": "node agent-pipeline/scripts/map-coverage.mjs",
    "content": "pnpm run check:content",
    "security_scope": "node agent-pipeline/scripts/security-scan.mjs check",
    "dast_baseline": "node agent-pipeline/scripts/security-scan.mjs baseline"
  },
  "architecture": {
    "id": "feature-modules",
    "project_type": "frontend",
    "decided_at": "2026-09-04",
    "layers": {
      "shared": ["src/shared/**"],
      "features": ["src/features/**"],
      "routes": ["src/routes/**"],
      "unplaced": ["src/*/**"]
    },
    "allowed": {
      "routes": ["features", "shared"],
      "features": ["shared"],
      "shared": [],
      "unplaced": []
    },
    "note": "Retenue contre feature-sliced : le routage par fichiers de SolidStart possede deja src/routes, et une couche pages supplementaire dupliquerait cette frontiere sans rien refuser de plus. Deux couches, une seule direction autorisee. AMENDEE le 2026-09-07 : features valait src/*/**, motif qui matchait AUSSI src/shared/**. Les deux couches se recouvraient entierement et la porte ne pouvait rien refuser — verte a vide. Elle designe desormais src/features/** seul. Le defaut a ete repere par l'operateur en lisant le code, jamais par une porte. AMENDEE le 2026-09-10 : routes et unplaced etaient absentes. layerOf classait src/routes a null, donc inspect ne visitait AUCUN import fait par une route — la porte lisait 13 imports inter-couches la ou elle en lit 24 desormais, et une route pouvait importer n'importe quoi sans que rien rougisse. unplaced vaut src/*/**, moins specifique que les trois autres couches : un repertoire pose a cote demain y tombe et ne peut rien atteindre, au lieu d'etre saute en silence. Les deux refus ont ete mesures en les provoquant, pas supposes."
  },
  "design_system": {
    "tokens": "src/shared/tokens.css",
    "primitives": "own",
    "primitives_sheet": "src/app.css",
    "decided_at": "2026-09-05",
    "mockup": "mockups/portfolio-v1.html",
    "direction": {
      "genre": "studio suisse",
      "because": "le produit est un inventaire de réalisations et de compétences, et la grille suisse est faite pour ordonner un inventaire sans l'uniformiser : la hiérarchie passe par l'échelle typographique et la position, pas par la couleur ni par l'effet. Retenue par l'opérateur après avoir écarté huit autres directions, ce qui rend le choix éprouvé plutôt que par défaut."
    }
  },
  "test_suites": {
    "unit": {
      "gate": "test_unit",
      "replay": "per_issue"
    },
    "browser": {
      "gate": "test_e2e",
      "replay": "closure"
    }
  },
  "closure_gates": ["coverage", "test_e2e", "dead_code", "audit", "content", "dast_baseline"],
  "project_map": {
    "out": "docs/project-map.md",
    "roots": ["src"],
    "skip": "(^|/)(dist|build|coverage|\\.output)/|\\.generated\\.",
    "regenerate": "pnpm run project-map"
  },
  "duplication": {
    "roots": ["src", "tests"],
    "min_lines": 6,
    "skip": "\\.generated\\.|shared/tokens\\.css$"
  },
  "doc_policy": {
    "roots": ["src", "tests"],
    "skip": "\\.generated\\.|\\.d\\.ts$"
  },
  "comment_policy": {
    "roots": ["src", "tests", "scripts"],
    "skip": "\\.generated\\."
  },
  "file_policy": {
    "orchestrator": {
      "allow": ["pipeline/store/**", "docs/project-map.md", ".sudocode/**"],
      "deny": ["src/**", "tests/**", "scripts/**"]
    },
    "product": {
      "allow": [".sudocode/**", "pipeline/pages/**", "pipeline/handoffs/**"],
      "deny": [
        "src/**",
        "tests/**",
        "scripts/**",
        "public/**",
        "pipeline/store/**",
        "pipeline/rules.json",
        "pipeline/agents/**",
        "pipeline/briefs/**",
        "pipeline/skills/**",
        "pipeline/profiles/**",
        "agent-pipeline/**",
        "pipeline.config.json",
        "AGENTS.md",
        "CLAUDE.md",
        ".github/**",
        "agent-pipeline.version"
      ]
    },
    "implementer": {
      "allow": [
        "src/**",
        "tests/**",
        "public/**",
        "mockups/**",
        "docs/**",
        "package.json",
        "pnpm-lock.yaml",
        "scripts/routes.mjs",
        "scripts/serve-static.mjs",
        "scripts/security-headers.mjs"
      ],
      "deny": [
        "pnpm-workspace.yaml",
        "pipeline.config.json",
        "AGENTS.md",
        "CLAUDE.md",
        ".github/**",
        "agent-pipeline/**",
        "pipeline/**",
        "docs/decisions/**",
        "agent-pipeline.version"
      ]
    },
    "qa": {
      "allow": [],
      "deny": ["**"]
    }
  },
  "human_review_paths": [
    "src/shared/tokens.css",
    "pipeline.config.json",
    "docs/decisions/**",
    ".github/**",
    "scripts/**",
    "agent-pipeline.version"
  ],
  "profiles_dir": "pipeline/profiles",
  "docs_dirs": ["agent-pipeline/docs", "docs/stack"],
  "briefs_dir": "pipeline/briefs",
  "prompts_dir": "pipeline/agents",
  "skills_dir": "pipeline/skills",
  "rules_path": "pipeline/rules.json",
  "project_context": "pipeline/project-context.md",
  "store_dir": "pipeline/store",
  "decisions_dir": "docs/decisions",
  "pages_dir": "pipeline/pages",
  "handoffs_dir": "pipeline/handoffs",
  "issue_tracker": {
    "provider": "sudocode",
    "enabled": true,
    "root": ".sudocode",
    "issues_file": "issues.jsonl",
    "specs_file": "specs.jsonl",
    "command": "sudocode",
    "args": [],
    "managed_tag": "agent-pipeline",
    "status_map": {
      "planned": "open",
      "in_progress": "in_progress",
      "ready_for_qa": "needs_review",
      "qa_in_progress": "needs_review",
      "closed": "closed",
      "blocked_*": "blocked",
      "operator_escalation": "blocked"
    }
  },
  "agent_runtime": {
    "prompt_adapter": "portable",
    "interactive_input": false,
    "runs_dir": "pipeline/runs",
    "progress_interval_seconds": 20,
    "command": "claude",
    "args": [
      "-p",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(date:*)",
      "--",
      "Tu es le rôle {role} du pipeline. Lis le task package JSON : {package}. Ses champs `prompt` et `brief` désignent ton prompt de rôle et ton brief compilé : lis-les intégralement et suis-les. Le champ `record` est ton issue. Termine par ton handoff JSON entre AGENT_HANDOFF_START et AGENT_HANDOFF_END, sans aucun texte après la balise de fermeture."
    ],
    "dependency_inputs": ["package.json", "pnpm-lock.yaml"],
    "workspace_paths": ["node_modules"]
  },
  "attempt_isolation": {
    "strategy": "git-worktree",
    "root": "pipeline/handoffs/worktrees",
    "one_attempt_per_worktree": true,
    "restore_before_replay": true
  },
  "evidence_retention": {
    "control_store": "pipeline/store",
    "run_records": "pipeline/runs",
    "handoffs": "pipeline/handoffs"
  },
  "workflow": {
    "max_transitions_per_run": 4,
    "gates": {
      "low": ["check", "lint", "test_unit"],
      "normal": ["check", "lint", "test_unit", "design_limits", "architecture", "smoke"],
      "high": "all"
    }
  },
  "findings_path": "pipeline/findings.md",
  "ci": {
    "provider": "github",
    "install": "corepack enable && pnpm install --frozen-lockfile && pnpm exec playwright install --with-deps chromium",
    "runtime_setup": {
      "uses": "actions/setup-node@v6",
      "with": {
        "node-version": "24"
      }
    },
    "gate_events": {
      "dast_baseline": ["pull_request"]
    },
    "timeout_minutes": 35,
    "secret_environment": [],
    "environment": {},
    "artifacts": {
      "name": "security-and-load-evidence",
      "paths": ["pipeline/security/reports/**/run.json"]
    },
    "artifact_upload": {
      "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"
    }
  },
  "security_testing": {
    "version": 1,
    "assurance": {
      "standard": "OWASP ASVS",
      "level": 1,
      "top10_2025": "docs/security/owasp-top10-2025.json"
    },
    "target": "http://127.0.0.1:41732",
    "allowed_targets": ["http://127.0.0.1:41732"],
    "allow_active": false,
    "environment": {
      "disposable": true,
      "external_side_effects": "disabled",
      "network": "host",
      "start": "pnpm run build && mkdir -p pipeline/runs && { nohup node scripts/serve-static.mjs 41732 .output/public > pipeline/runs/security-env.log 2>&1 & echo $! > pipeline/runs/security-env.pid; }",
      "stop": "if [ -f pipeline/runs/security-env.pid ]; then kill \"$(cat pipeline/runs/security-env.pid)\" 2>/dev/null || true; rm -f pipeline/runs/security-env.pid; fi",
      "health_url": "http://127.0.0.1:41732/fr",
      "health_timeout_seconds": 60
    },
    "zap": {
      "image": "ghcr.io/zaproxy/zaproxy@sha256:781a2bdaea47324e7bab583e2263f21d257b0aee61ed51521a5be45f5f5081ef",
      "spider": "traditional",
      "reports_dir": "pipeline/security/reports",
      "max_scan_minutes": 5,
      "max_rule_minutes": 1,
      "threads_per_host": 2,
      "fail_level": "Medium",
      "warn_level": "Low"
    },
    "accepted_findings": "docs/security/accepted-findings.json",
    "authentication": {
      "method": "none"
    }
  }
}
